# Copy to .env.docker and change every "change-me". Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
DEBUG=false
# Addresses people type in the browser (comma separated): server IP and/or domain
ALLOWED_HOSTS=localhost,127.0.0.1
# With HTTPS: HTTPS=true and CSRF_TRUSTED_ORIGINS=https://attendance.example.com
HTTPS=false
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata

# PostgreSQL (the "db" service). Use the same password in both places.
POSTGRES_DB=bioattend
POSTGRES_USER=bioattend
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://bioattend:change-me@db:5432/bioattend

# Optional: e-mail errors to the administrators
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_FROM=bioattend@example.com
# ADMIN_EMAILS=it@example.com
