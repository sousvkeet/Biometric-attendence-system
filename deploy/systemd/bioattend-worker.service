# /etc/systemd/system/bioattend-worker.service  – device sync, live punches, scheduled backups
# Run exactly ONE worker per installation (a second one refuses to start).
[Unit]
Description=BioAttend device worker
After=network-online.target bioattend-web.service
Wants=network-online.target

[Service]
Type=simple
User=bioattend
Group=bioattend
WorkingDirectory=/opt/bioattend
ExecStart=/opt/bioattend/.venv/bin/python manage.py run_worker
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
