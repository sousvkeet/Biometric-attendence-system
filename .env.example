# BioAttend configuration. Copy to .env (chmod 600 .env) and adjust.
# Docker installations use .env.docker instead (see .env.docker.example).

# Long random secret – generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later means re-entering stored backup-destination passwords.
SECRET_KEY=change-me
DEBUG=false

# Names/IPs people use to open the portal, comma separated (no "*" in production)
ALLOWED_HOSTS=localhost,127.0.0.1
# With HTTPS (reverse proxy): HTTPS=true and the full address(es) here
HTTPS=false
CSRF_TRUSTED_ORIGINS=

# Time zone of the biometric devices' clocks
TIME_ZONE=Asia/Kolkata

# Database: empty = SQLite file db.sqlite3. PostgreSQL (recommended for production):
# DATABASE_URL=postgres://bioattend:PASSWORD@localhost:5432/bioattend

# Login lockout
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Logs go to var/log (rotated). LOG_TO_FILE=false logs to the console only.
LOG_TO_FILE=true

# Optional: e-mail errors to the administrators
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_FROM=bioattend@example.com
# ADMIN_EMAILS=it@example.com

# Optional overrides
# VAR_DIR=/srv/bioattend-data      (logs, backup work area, cache)
# RCLONE_BINARY=/usr/bin/rclone
