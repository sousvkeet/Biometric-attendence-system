<?xml version="1.0" encoding="utf-8"?>
<!--
  BioAttend for Windows - MSI package (WiX Toolset 5). Built by desktop/build_windows.ps1:
    wix build desktop\msi\BioAttend.wxs -arch x64 -d Version=1.0.0 -d SourceDir=dist\BioAttend -o dist\BioAttend-1.0.0.msi

  Per-machine installation into "C:\Program Files\BioAttend" (needs administrator rights; suitable for Group Policy,
  Intune and SCCM). Each Windows user's data stays in %LOCALAPPDATA%\BioAttend and is never removed by the MSI.
  The UpgradeCode must never change: it lets newer MSIs replace older ones.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="BioAttend"
           Manufacturer="BioAttend"
           Version="$(Version)"
           UpgradeCode="6433B25A-14AE-43CB-8C38-9973FC7D4D14"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="BioAttend - biometric attendance for ZKTeco devices" Manufacturer="BioAttend" />
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of BioAttend is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="mszip" />

    <Icon Id="BioAttendIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="BioAttendIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPCOMMENTS" Value="Your data in %LOCALAPPDATA%\BioAttend is kept when BioAttend is removed." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="BioAttend">
        <Files Include="$(SourceDir)\**" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="BioAttendMenu" Name="BioAttend">
        <Component Id="StartMenuShortcuts" Guid="40D7ED7C-BB74-42F0-BBED-65F7E1C95DB3">
          <Shortcut Id="AppShortcut" Name="BioAttend" Description="Biometric attendance"
                    Target="[INSTALLFOLDER]BioAttend.exe" WorkingDirectory="INSTALLFOLDER" Icon="BioAttendIcon" />
          <Shortcut Id="BackupShortcut" Name="Back up BioAttend now" Description="Back up with the saved settings"
                    Target="[INSTALLFOLDER]BioAttend.exe" Arguments="--backup" WorkingDirectory="INSTALLFOLDER"
                    Icon="BioAttendIcon" />
          <RemoveFolder Id="RemoveBioAttendMenu" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\BioAttend" Name="StartMenuShortcuts" Type="integer" Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="C2A0F3E1-6B4B-4F3A-9C2E-7E1D2B6A9F10">
        <Shortcut Id="DesktopAppShortcut" Name="BioAttend" Target="[INSTALLFOLDER]BioAttend.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="BioAttendIcon" />
        <RegistryValue Root="HKCU" Key="Software\BioAttend" Name="DesktopShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Ask a running BioAttend to quit before files are replaced or removed (keeps the database consistent). -->
    <CustomAction Id="QuitRunningBioAttend" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]BioAttend.exe&quot; --quit" Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="QuitRunningBioAttend" Before="InstallValidate" Condition="Installed OR WIX_UPGRADE_DETECTED" />
    </InstallExecuteSequence>
  </Package>
</Wix>
